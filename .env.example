# ==========================================
# BarVision / SpiritSync Environment Config
# ==========================================

# Google Gemini API (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=cocktails_catalog

# Jaeger Tracing (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=barvision-backend

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
