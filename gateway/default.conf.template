# Rendered by the nginx image's envsubst (only API_RATE / API_BURST are substituted).
# Lives in conf.d/, i.e. inside the http {} context.

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=${API_RATE};

upstream api_gateway {
    server api:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name localhost;

    client_max_body_size 5M;   # client sends ~300KB compressed images

    location /health {
        default_type application/json;
        return 200 '{"status":"gateway_healthy"}';
    }

    # SSE: no buffering, long-lived connection, never rate limited
    location ~ ^/api/v1/tasks/.+/stream$ {
        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 600s;
    }

    location /api/ {
        limit_req zone=api_limit burst=${API_BURST} nodelay;
        limit_req_status 429;

        proxy_pass http://api_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
